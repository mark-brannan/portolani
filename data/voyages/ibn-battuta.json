  "events": [
    {"kind": "event", "lon": 39.83, "lat": 21.42, "date": "1326", "label": "First hajj at Mecca", "source": "Rihla", "cite": "gibb-ibn-battuta", "text": "He left Tangier at twenty-one, alone, meaning to make the pilgrimage and come home. He reached Mecca in 1326 and the road went on for nearly thirty years.", "who": "Ibn Battuta"},
    {"kind": "landfall", "lon": 39.52, "lat": -8.96, "date": "1329 (Rihla: 1331)", "label": "Kilwa, the southernmost point of the journey", "source": "Rihla", "cite": "gibb-ibn-battuta", "text": "The Rihla calls Kilwa one of the most beautiful and well-built towns in the world, a city of stone and coral on an island, and its sultan renowned for giving. It was the southern end of the Swahili gold trade, and the furthest he went.", "who": "Ibn Battuta"},
    {"kind": "event", "lon": 77.21, "lat": 28.61, "date": "1334–41", "label": "Delhi: eight years as a qadi for Muhammad bin Tughluq", "source": "Rihla", "cite": "gibb-ibn-battuta", "text": "Sultan Muhammad bin Tughluq made him a judge, a qadi, with a large salary and a house. He fell into debt, then under suspicion, and lived through some bad years before the sultan sent him off as ambassador to China.", "who": "Ibn Battuta"},
    {"kind": "event", "lon": 73.5, "lat": 4.18, "date": "1343–44", "label": "The Maldives: qadi of the islands", "source": "Rihla", "cite": "gibb-ibn-battuta", "text": "Shipwreck and robbery on the way to China left him in the Maldives, where he stayed nine months as chief judge, and married into island families. A quarrel with the vizier sent him on his way.", "who": "Ibn Battuta"},
    {"kind": "landfall", "lon": 118.68, "lat": 24.88, "date": "1345–46", "label": "Zaytun (Quanzhou), the Chinese port", "source": "Rihla", "cite": "gibb-ibn-battuta", "text": "He calls it Zaytun and says its harbour was one of the greatest in the world, with a hundred large junks and small ones past counting. The Rihla is one of the few eyewitness accounts of a Chinese port in the Yuan years.", "who": "Ibn Battuta"},
    {"kind": "event", "lon": 36.3, "lat": 33.51, "date": "1348", "label": "Damascus in the year of the Black Death", "source": "Rihla", "cite": "gibb-ibn-battuta", "text": "The plague reached Damascus in 1348. The Rihla describes Muslims, Jews and Christians processing together to pray, fasting for three days, and puts the dead at some 2,400 a day. He had come from Aleppo, where word came that it was killing more than a thousand a day in Gaza.", "who": "Ibn Battuta"},
    {"kind": "event", "lon": -8.8, "lat": 11.4, "date": "1352–53", "label": "The court of Mansa Sulayman, Mali", "source": "Rihla", "cite": "gibb-ibn-battuta", "text": "The sultan of Mali sent him three loaves of bread, a piece of beef fried in shea butter and a gourd of curds, which Ibn Battuta thought a poor welcome and said so. He praised the people all the same for their justice, the safety of their roads, and their hatred of injustice.", "who": "Ibn Battuta"}
  ]
}
