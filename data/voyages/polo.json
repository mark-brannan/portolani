  "events": [
    {
      "kind": "event",
      "lon": 56.95,
      "lat": 27.1,
      "date": "1272",
      "label": "Hormuz, where the Polos turned back from the sea",
      "text": "The Polos meant to go on to China by ship, but the Hormuz vessels, their planks sewn together with coconut fibre and not a nail in them, looked unsafe, so they turned inland and went overland across Persia and the Pamirs. Marco came back by sea twenty years later, and landed here again.",
      "source": "Polo, Book (Yule–Cordier)",
      "cite": "the-travels-of-marco-polo"
    },
    {
      "kind": "event",
      "lon": 116.18,
      "lat": 42.36,
      "date": "1275",
      "label": "Shangdu, Kublai Khan's summer court",
      "text": "Xanadu in Coleridge's poem. Marco describes a palace of marble and gilded rooms in a walled park full of game, where Kublai Khan spent the summer. The site, in Inner Mongolia, is ruins and grass today.",
      "source": "Polo, Book (Yule–Cordier)",
      "cite": "the-travels-of-marco-polo"
    },
    {
      "kind": "event",
      "lon": 97.6,
      "lat": 5.2,
      "date": "1292",
      "label": "Samudra, five months waiting for the monsoon",
      "text": "The fleet escorting a Mongol princess to Persia waited five months here, at Sumatra, for the monsoon to turn. Marco saw what he called unicorns, ugly beasts with a single horn and a taste for mud: rhinoceroses.",
      "source": "Polo, Book (Yule–Cordier)",
      "cite": "the-travels-of-marco-polo"
    }
  ]
