  "events": [
    {
      "kind": "event",
      "lon": 12.5,
      "lat": 41.9,
      "date": "c. 1166",
      "label": "Rome, c. 1166",
      "text": "He counted about two hundred Jews in Rome, honourably placed, paying no tribute, and some of them officials of Pope Alexander III. He lists the palaces and churches, among them the one he says is Titus's.",
      "source": "Benjamin of Tudela, Itinerary (Adler's translation, 1907)",
      "cite": "adler-itinerary-of-benjamin",
      "confidence": "attested"
    },
    {
      "kind": "event",
      "lon": 28.98,
      "lat": 41.01,
      "date": "c. 1168",
      "label": "Constantinople and the Hippodrome, c. 1168",
      "text": "He describes Manuel's capital, its wealth, the Hagia Sophia and the Blachernae palace, and the Hippodrome, where on Christmas Day men from every nation came before the Emperor to see jugglers and wild beasts fight.",
      "source": "Benjamin of Tudela, Itinerary (Adler's translation, 1907)",
      "cite": "adler-itinerary-of-benjamin",
      "confidence": "attested"
    },
    {
      "kind": "event",
      "lon": 35.23,
      "lat": 31.78,
      "date": "c. 1170",
      "label": "Jerusalem and the tomb of David, c. 1170",
      "text": "In Crusader Jerusalem he found a small Jewish community. On Mount Zion he tells how a wall of the church fell fifteen years before, and workmen restoring it came upon the sepulchre of the House of David.",
      "source": "Benjamin of Tudela, Itinerary (Adler's translation, 1907)",
      "cite": "adler-itinerary-of-benjamin",
      "confidence": "attested"
    },
    {
      "kind": "event",
      "lon": 43.13,
      "lat": 36.34,
      "date": "c. 1170",
      "label": "Nineveh from Mosul, c. 1170",
      "text": "Across the Tigris from Mosul he saw Nineveh in ruins, with villages among them, and the walls running forty parasangs to Irbil.",
      "source": "Benjamin of Tudela, Itinerary (Adler's translation, 1907)",
      "cite": "adler-itinerary-of-benjamin",
      "confidence": "attested"
    },
    {
      "kind": "event",
      "lon": 44.37,
      "lat": 33.31,
      "date": "c. 1170",
      "label": "Baghdad, c. 1170",
      "text": "He counted twenty-eight synagogues, among them the great one of the head of the exile with marble columns overlaid with gold and silver, and describes the exilarch, a prince of the House of David, riding to his installation.",
      "source": "Benjamin of Tudela, Itinerary (Adler's translation, 1907)",
      "cite": "adler-itinerary-of-benjamin",
      "confidence": "attested"
    },
    {
      "kind": "event",
      "lon": 39.29,
      "lat": 25.69,
      "label": "Khaybar, heard of, not visited",
      "text": "He reports a very large city with 50,000 Jews, who people say belong to the tribes of Reuben, Gad and Manasseh. He had this from others and did not go; nothing east or south of Baghdad is drawn as a route.",
      "source": "Benjamin of Tudela, Itinerary (Adler's translation, 1907)",
      "cite": "adler-itinerary-of-benjamin",
      "confidence": "speculative",
      "doubt": "Benjamin tells of Khaybar, Teima, Yemen, Persia, India and China on report; whether any of it was seen is disputed."
    },
    {
      "kind": "event",
      "lon": 66.96,
      "lat": 39.65,
      "label": "Samarkand, heard of, not visited",
      "text": "He reports a community of fifty thousand Jews in Samarkand, on the border of the Persian kingdom. Like the rest of the east, it is told at second hand.",
      "source": "Benjamin of Tudela, Itinerary (Adler's translation, 1907)",
      "cite": "adler-itinerary-of-benjamin",
